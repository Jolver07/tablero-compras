{
  // Configuración para Cloudflare Workers (Workers & Pages → Import a repository).
  // Comando de despliegue: npx wrangler deploy   ·   Comando de compilación: (vacío)
  "name": "tablero-compras",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Almacenamiento de los datos publicados con "Publicar para todos".
  // La clave de administrador va como secreto ADMIN_KEY en Settings → Variables and Secrets (no aquí).
  "kv_namespaces": [
    { "binding": "DATOS", "id": "94346c9102c34e66a75cba01a2752a3f" }
  ]
}
